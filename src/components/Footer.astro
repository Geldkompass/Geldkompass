---
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();

const links = [
  { href: '/blog', label: 'Blog' },
  { href: '/ueber-mich', label: 'Über mich' },
  { href: '/newsletter', label: 'Newsletter' },
  { href: '/kontakt', label: 'Kontakt' },
  { href: '/impressum', label: 'Impressum' },
  { href: '/impressum#disclaimer', label: 'Disclaimer' },
  { href: '/datenschutz', label: 'Datenschutz' },
];
---

<footer style="background-color: var(--color-navy-950);">
  <div class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
    <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-5">
      <a href="/" class="inline-flex items-center gap-2.5">
        <svg width="26" height="26" viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="17" cy="17" r="15.5" stroke="var(--color-gold-500)" stroke-width="2" />
          <circle cx="17" cy="17" r="1.6" fill="var(--color-gold-500)" />
          <path d="M17 7L20.5 15.5L17 27L13.5 15.5L17 7Z" fill="var(--color-cream-50)" />
        </svg>
        <span class="font-display text-base font-semibold text-white">Geldkompass</span>
      </a>
      <SocialLinks variant="dark" />
      </div>

      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm" style="color: var(--color-navy-500);">
          {links.map((link) => (
            <li><a href={link.href} class="transition-colors hover:text-white">{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-6 flex flex-col gap-2 border-t pt-5 text-xs sm:flex-row sm:items-center sm:justify-between" style="border-color: var(--color-navy-800); color: var(--color-navy-600);">
      <p>&copy; {year} Geldkompass. Alle Angaben ohne Gewähr.</p>
      <p>Keine Anlageberatung, nur Bildung.</p>
    </div>
  </div>
</footer>
