---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

// Brevo-Formular (Liste "Geldkompass Newsletter", Double-Opt-in aktiv).
// Bestätigungs-Redirects sind in Brevo auf /newsletter/bestaetigen und
// /newsletter/willkommen konfiguriert.
const brevoAction =
  'https://989769fc.sibforms.com/serve/MUIFAJXMzZfgxr_1OZk9p26cF7KzsQxd2GDR3Pj5BAtqesttqP_Ipkmvwxx-xhdSRXMKM7cNp_qyLIgRWojjs-RI6SOlCtKJwF0YfyyqYXtAvzmCUhgouulc4avncDRMd9QnoBPru_OhF3eOvNMNjmNrigwQN4xsjVC29-s9y_bNzV3EAWR7pPZ0vZCqext5MD4RonXYNTMdkfKHkw==';
---

<div
  class:list={[
    'rounded-2xl border px-6 py-8 sm:px-10 sm:py-10',
    compact ? '' : 'text-center',
  ]}
  style="background-color: var(--color-navy-900); border-color: var(--color-navy-800);"
>
  <h3 class="font-display text-2xl font-semibold text-white">
    Der Geldkompass-Newsletter
  </h3>
  <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed" style="color: var(--color-navy-500);">
    Neue Artikel, Steuer-Updates und Finanzthemen direkt ins Postfach. Kein Spam,
    nur wenn es wirklich etwas Neues gibt.
  </p>

  <form
    method="POST"
    action={brevoAction}
    class="mx-auto mt-6 flex max-w-sm flex-col gap-3 sm:flex-row"
  >
    <label for="EMAIL" class="sr-only">E-Mail-Adresse</label>
    <input
      id="EMAIL"
      name="EMAIL"
      type="email"
      autocomplete="off"
      required
      placeholder="deine@email.at"
      class="w-full rounded-lg border-0 px-4 py-2.5 text-sm text-ink-900 placeholder:text-ink-500 focus:outline-none focus:ring-2"
      style="background-color: var(--color-cream-50); --tw-ring-color: var(--color-gold-500);"
    />

    <!-- Honeypot gegen Spam-Bots, muss leer bleiben -->
    <input
      type="text"
      name="email_address_check"
      value=""
      tabindex="-1"
      autocomplete="off"
      style="position: absolute; left: -9999px;"
    />
    <input type="hidden" name="locale" value="de" />
    <input type="hidden" name="html_type" value="simple" />

    <button
      type="submit"
      class="shrink-0 rounded-lg px-5 py-2.5 text-sm font-semibold transition-colors"
      style="background-color: var(--color-gold-500); color: var(--color-navy-950);"
    >
      Anmelden
    </button>
  </form>
  <p class="mt-3 text-xs" style="color: var(--color-navy-600);">
    Du bekommst gleich eine Bestätigungsmail. Erst wenn du auf den Link darin klickst, bist du
    angemeldet (Double-Opt-in).
  </p>
</div>
