---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const contactEmail = 'kontakt@geld-kompass.at';
---

<div
  class:list={[
    'rounded-2xl border px-6 py-8 sm:px-10 sm:py-10',
    compact ? '' : 'text-center',
  ]}
  style="background-color: var(--color-navy-900); border-color: var(--color-navy-800);"
>
  <span
    class="inline-block rounded-full px-3 py-1 text-xs font-semibold tracking-wide uppercase"
    style="background-color: var(--color-gold-500); color: var(--color-navy-950);"
  >
    Bald verfügbar
  </span>
  <h3 class="mt-4 font-display text-2xl font-semibold text-white">
    Der Geldkompass-Newsletter
  </h3>
  <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed" style="color: var(--color-navy-500);">
    Neue Artikel, Steuer-Updates und Finanzthemen direkt ins Postfach — kein Spam,
    unregelmäßig aber wertvoll. Der automatische Versand ist noch im Aufbau.
  </p>

  <form
    id="newsletter-form"
    class="mx-auto mt-6 flex max-w-sm flex-col gap-3 sm:flex-row"
    data-contact={contactEmail}
  >
    <label for="newsletter-email" class="sr-only">E-Mail-Adresse</label>
    <input
      id="newsletter-email"
      type="email"
      required
      placeholder="deine@email.at"
      class="w-full rounded-lg border-0 px-4 py-2.5 text-sm text-ink-900 placeholder:text-ink-500 focus:outline-none focus:ring-2"
      style="background-color: var(--color-cream-50); --tw-ring-color: var(--color-gold-500);"
    />
    <button
      type="submit"
      class="shrink-0 rounded-lg px-5 py-2.5 text-sm font-semibold transition-colors"
      style="background-color: var(--color-gold-500); color: var(--color-navy-950);"
    >
      Vormerken lassen
    </button>
  </form>
  <p id="newsletter-note" class="mt-3 text-xs" style="color: var(--color-navy-600);">
    Öffnet dein E-Mail-Programm mit einer vorausgefüllten Anfrage — so landest du auf der Liste,
    sobald der Newsletter startet.
  </p>
</div>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const note = document.getElementById('newsletter-note');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const email = (document.getElementById('newsletter-email') as HTMLInputElement)?.value.trim();
    const contact = form.dataset.contact;
    if (!email || !contact) return;

    const subject = encodeURIComponent('Newsletter-Anmeldung Geldkompass');
    const body = encodeURIComponent(
      `Hallo,\n\nbitte trag mich mit dieser Adresse in den Geldkompass-Newsletter ein:\n${email}\n\nDanke!`
    );
    window.location.href = `mailto:${contact}?subject=${subject}&body=${body}`;

    if (note) {
      note.textContent = 'Dein E-Mail-Programm öffnet sich gleich mit einer vorausgefüllten Nachricht.';
    }
  });
</script>
