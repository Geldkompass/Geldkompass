---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const topics = [
  {
    name: 'Investieren',
    title: 'Investieren von Grund auf',
    description: 'ETFs, Depots und Diversifikation. Die Basics für alle, die gerade erst anfangen.',
    accent: 'var(--color-cat-investieren)',
    icon: 'M4 19h16M6 15l4-4 3 3 5-6M15 8h3v3',
  },
  {
    name: 'Steuern',
    title: 'Steuern in Österreich',
    description: 'KESt, Meldefonds und Verlustausgleich, erklärt ohne Juristendeutsch.',
    accent: 'var(--color-cat-steuern)',
    icon: 'M7 3h7l4 4v14H7zM14 3v4h4M10 16l5-5M10.5 11.5h.01M14.5 15.5h.01',
  },
  {
    name: 'Wirtschaft',
    title: 'Wirtschaft & Aktuelles',
    description: 'Einordnung von Zinsentscheidungen, Inflation und anderen Ereignissen am Markt.',
    accent: 'var(--color-cat-wirtschaft)',
    icon: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM3.6 9h16.8M3.6 15h16.8M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18',
  },
];
---

<Layout title="Geldkompass">
  <!-- Hero -->
  <section class="relative overflow-hidden" style="background-color: var(--color-navy-950);">
    <svg
      class="pointer-events-none absolute -right-24 -top-24 opacity-[0.08] sm:-right-10"
      width="480"
      height="480"
      viewBox="0 0 34 34"
      fill="none"
    >
      <circle cx="17" cy="17" r="15.5" stroke="white" stroke-width="0.5" />
      <circle cx="17" cy="17" r="1" fill="white" />
      <path d="M17 7L20.5 15.5L17 27L13.5 15.5L17 7Z" fill="white" />
    </svg>

    <div class="relative mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <span
        class="inline-block rounded-full px-3 py-1 text-xs font-semibold tracking-wide uppercase"
        style="background-color: var(--color-gold-500); color: var(--color-navy-950);"
      >
        Finanzen &amp; Steuern in Österreich
      </span>
      <h1 class="mt-6 max-w-2xl font-display text-4xl font-bold leading-tight text-white sm:text-5xl">
        Orientierung im Finanz&shy;dschungel, verständlich erklärt.
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed" style="color: var(--color-navy-500);">
        Geldkompass hilft dir, Investieren und Steuern in Österreich wirklich zu verstehen. Ohne
        Fachchinesisch und ohne dir etwas verkaufen zu wollen. Ich baue mein Wissen und mein eigenes Portfolio hier
        transparent mit auf.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/blog"
          class="rounded-lg px-6 py-3 text-sm font-semibold transition-transform hover:-translate-y-0.5"
          style="background-color: var(--color-gold-500); color: var(--color-navy-950);"
        >
          Artikel entdecken
        </a>
        <a
          href="/ueber-mich"
          class="rounded-lg border px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10"
          style="border-color: var(--color-navy-700);"
        >
          Über mich
        </a>
      </div>
    </div>
  </section>

  <!-- Themen -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <h2 class="font-display text-2xl font-bold" style="color: var(--color-navy-950);">Themen</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {topics.map((topic) => (
        <a
          href={`/blog#${topic.name.toLowerCase()}`}
          class="group flex flex-col rounded-2xl border-2 p-6 transition-all hover:-translate-y-1 hover:shadow-lg"
          style={`border-color: color-mix(in srgb, ${topic.accent} 25%, transparent); background-color: white;`}
        >
          <span
            class="flex h-12 w-12 items-center justify-center rounded-xl"
            style={`background-color: color-mix(in srgb, ${topic.accent} 12%, transparent); color: ${topic.accent};`}
          >
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={topic.icon} />
            </svg>
          </span>
          <h3 class="mt-4 font-display text-lg font-semibold" style="color: var(--color-navy-950);">
            {topic.title}
          </h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed" style="color: var(--color-ink-700);">
            {topic.description}
          </p>
          <span
            class="mt-5 inline-flex items-center gap-2 self-start rounded-lg px-4 py-2 text-sm font-semibold text-white transition-transform group-hover:translate-x-0.5"
            style={`background-color: ${topic.accent};`}
          >
            Zu den Artikeln
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Neueste Artikel -->
  <section class="border-t" style="border-color: var(--color-cream-200); background-color: var(--color-cream-100);">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
      <div class="flex items-baseline justify-between">
        <h2 class="font-display text-2xl font-bold" style="color: var(--color-navy-950);">Neueste Artikel</h2>
        <a href="/blog" class="text-sm font-semibold" style="color: var(--color-navy-700);">Alle Artikel &rarr;</a>
      </div>

      {latestPosts.length === 0 ? (
        <p class="mt-10" style="color: var(--color-ink-500);">Die ersten Artikel kommen in Kürze.</p>
      ) : (
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {latestPosts.map((entry, i) => (
            <ArticleCard entry={entry} featured={i === 0} />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Positionierung -->
  <section class="mx-auto max-w-4xl px-5 py-16 text-center sm:px-8">
    <h2 class="font-display text-2xl font-bold" style="color: var(--color-navy-950);">
      Warum Geldkompass?
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed" style="color: var(--color-ink-700);">
      Die meisten deutschsprachigen Finanzblogs erklären Investieren eher allgemein, und die
      österreichischen Steuern kommen oft zu kurz. Hier setzt Geldkompass an. Was ich im Studium
      zu Finanzen und Steuern lerne, verbinde ich mit den Grundlagen, die jede:r Einsteiger:in
      beim Investieren kennen sollte.
    </p>
  </section>

  <!-- Newsletter -->
  <section class="mx-auto max-w-4xl px-5 pb-20 sm:px-8">
    <NewsletterSignup />
  </section>
</Layout>
