---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = ['Alle', 'Investieren', 'Steuern', 'Wirtschaft'] as const;
---

<Layout
  title="Blog"
  description="Alle Artikel von Geldkompass: Investieren, ETFs und Steuern in Österreich — verständlich erklärt."
>
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <header class="max-w-2xl">
      <h1 class="font-display text-4xl font-bold" style="color: var(--color-navy-950);">Blog</h1>
      <p class="mt-3 text-lg leading-relaxed" style="color: var(--color-ink-700);">
        Alle Artikel an einem Ort — von den Grundlagen des Investierens bis zu Steuerthemen für
        Kapitalanleger:innen in Österreich.
      </p>
    </header>

    <div class="mt-8 flex flex-wrap gap-2" role="tablist" aria-label="Nach Kategorie filtern">
      {categories.map((cat) => (
        <button
          type="button"
          class="filter-btn rounded-full border px-4 py-1.5 text-sm font-medium transition-colors"
          data-filter={cat}
          style="border-color: var(--color-cream-200); color: var(--color-ink-700);"
        >
          {cat}
        </button>
      ))}
    </div>

    {allPosts.length === 0 ? (
      <p class="mt-14 text-center" style="color: var(--color-ink-500);">
        Noch keine Artikel veröffentlicht — schau bald wieder vorbei.
      </p>
    ) : (
      <div id="article-grid" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {allPosts.map((entry) => (
          <div class="article-item" data-category={entry.data.category}>
            <ArticleCard entry={entry} />
          </div>
        ))}
      </div>
    )}

    <p id="empty-state" class="mt-14 hidden text-center" style="color: var(--color-ink-500);">
      Noch keine Artikel in dieser Kategorie.
    </p>
  </div>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.article-item');
  const emptyState = document.getElementById('empty-state');

  function setActive(filter: string) {
    let visibleCount = 0;
    items.forEach((item) => {
      const match = filter === 'Alle' || item.dataset.category === filter;
      item.classList.toggle('hidden', !match);
      if (match) visibleCount++;
    });
    emptyState?.classList.toggle('hidden', visibleCount !== 0);

    buttons.forEach((btn) => {
      const isActive = btn.dataset.filter === filter;
      btn.style.backgroundColor = isActive ? 'var(--color-navy-950)' : 'transparent';
      btn.style.color = isActive ? 'white' : 'var(--color-ink-700)';
      btn.style.borderColor = isActive ? 'var(--color-navy-950)' : 'var(--color-cream-200)';
      btn.setAttribute('aria-selected', String(isActive));
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => setActive(btn.dataset.filter ?? 'Alle'));
  });

  setActive('Alle');
</script>
