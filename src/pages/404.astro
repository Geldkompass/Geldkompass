---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Seite nicht gefunden">
  <div class="mx-auto flex max-w-xl flex-col items-center px-5 py-24 text-center sm:px-8">
    <svg width="64" height="64" viewBox="0 0 34 34" fill="none">
      <circle cx="17" cy="17" r="15.5" stroke="var(--color-gold-500)" stroke-width="2" />
      <circle cx="17" cy="17" r="1.6" fill="var(--color-gold-500)" />
      <path d="M12 12L22 22M22 12L12 22" stroke="var(--color-navy-900)" stroke-width="2" stroke-linecap="round" />
    </svg>
    <h1 class="mt-6 font-display text-3xl font-bold" style="color: var(--color-navy-950);">
      Der Kompass zeigt hier ins Leere
    </h1>
    <p class="mt-3 text-lg" style="color: var(--color-ink-700);">
      Diese Seite gibt es nicht (mehr). Vielleicht hilft dir einer der Links weiter.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/" class="rounded-lg px-6 py-3 text-sm font-semibold" style="background-color: var(--color-navy-950); color: white;">
        Zur Startseite
      </a>
      <a href="/blog" class="rounded-lg border px-6 py-3 text-sm font-semibold" style="border-color: var(--color-cream-200); color: var(--color-navy-950);">
        Zum Blog
      </a>
    </div>
  </div>
</Layout>
